# Fallback for Apache hosts whose DocumentRoot still points at the application
# root instead of public/. Every request is mapped into public/, so nothing
# outside it (config/, db/, functions/, route/ …) is served directly.
# Preferred setup: DocumentRoot /path/to/php-ssl/public (then this file is unused).

<IfModule mod_rewrite.c>
RewriteEngine on
RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
Require all denied
</IfModule>
